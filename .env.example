# Copy to .env.local and fill in your values:
#   cp .env.example .env.local

# Required — PostgreSQL connection string
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/account_management?schema=public"
# Neon example (use the *pooled* connection string from the Neon dashboard):
# DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL=

# Optional login credentials (defaults: admin / admin123)
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD=admin123

# Optional — session signing secret (use any long random string locally)
APP_SESSION_SECRET=change-me-to-a-long-random-string
